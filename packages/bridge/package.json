{
  "name": "@andrey-kokoev/wenyan-bridge",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/nats": {
      "types": "./dist/adapters/nats.d.ts",
      "import": "./dist/adapters/nats.js"
    },
    "./adapters/kafka": {
      "types": "./dist/adapters/kafka.d.ts",
      "import": "./dist/adapters/kafka.js"
    },
    "./adapters/mqtt": {
      "types": "./dist/adapters/mqtt.d.ts",
      "import": "./dist/adapters/mqtt.js"
    },
    "./adapters/erp-http": {
      "types": "./dist/adapters/erp-http.d.ts",
      "import": "./dist/adapters/erp-http.js"
    },
    "./adapters/payroll-http": {
      "types": "./dist/adapters/payroll-http.d.ts",
      "import": "./dist/adapters/payroll-http.js"
    },
    "./adapters/regulatory-mqtt": {
      "types": "./dist/adapters/regulatory-mqtt.d.ts",
      "import": "./dist/adapters/regulatory-mqtt.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    }
  },
  "bin": {
    "wenyan-bridge": "dist/bin.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-kokoev/wenyan.git",
    "directory": "packages/bridge"
  },
  "scripts": {
    "pretest": "node ./scripts/ensure-nats-server.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "lint": "echo 'no lint configured yet'"
  },
  "dependencies": {
    "@andrey-kokoev/wenyan-archive": "workspace:*",
    "@andrey-kokoev/wenyan-core": "workspace:*",
    "@andrey-kokoev/wenyan-crdt": "workspace:*",
    "nats": "^2.29.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "nats-memory-server": "2.0.21",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
