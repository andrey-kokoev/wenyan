{
  "name": "@wenyan/app",
  "version": "0.1.0",
  "description": "Wenyan frontend app",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:hono\" \"npm:dev:vite\"",
    "dev:local": "concurrently \"npm:dev:hono:local\" \"npm:dev:vite\"",
    "dev:hono": "cd ../server && pnpm dev",
    "dev:hono:local": "cd ../server && pnpm dev:local",
    "dev:vite": "kill -9 $(lsof -t -i:5175) 2>/dev/null || true && vite",
    "dev:remote": "OPENHUB_REMOTE=true concurrently \"npm:dev:hono\" \"npm:dev:vite\"",
    "build": "vite build",
    "build:prod": "VITE_API_URL=https://wenyan.andrei-kokoev.workers.dev vite build",
    "deploy": "pnpm build:prod && wrangler pages deploy dist --project-name=wenyan-app --branch=main",
    "typecheck": "vue-tsc --noEmit",
    "lint:classes": "ast-grep scan --config .ast-grep/config.yml client/src",
    "lint": "oxlint client/src && pnpm lint:classes"
  },
  "dependencies": {
    "@wenyan/server": "workspace:*",
    "@wenyan/shared": "workspace:*",
    "@iconify/vue": "^5.0.0",
    "@openhub2/provider-cloudflare": "link:../../../openhub/packages/providers/cloudflare",
    "@openhub2/runtime-hono": "link:../../../openhub/packages/runtimes/hono",
    "@vueuse/core": "14.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "hono": "^4.11.7",
    "json5": "^2.2.3",
    "jsonrepair": "^3.9.1",
    "lucide-vue-next": "^0.563.0",
    "pinia": "^3.0.4",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.8.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.27",
    "vue-router": "^5.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.40.5",
    "@cloudflare/workers-types": "^4.20260203.0",
    "@iconify-json/lucide": "^1.2.88",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "concurrently": "^9.2.1",
    "shadcn-vue": "^2.4.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.4",
    "wrangler": "^4.62.0"
  }
}
