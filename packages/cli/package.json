{
  "name": "@wenyan/cli",
  "version": "0.6.0",
  "type": "module",
  "bin": {
    "wenyan": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-kokoev/wenyan.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests configured yet'",
    "lint": "echo 'no lint configured yet'"
  },
  "dependencies": {
    "@wenyan/archive": "workspace:*",
    "@wenyan/bridge": "workspace:*",
    "@wenyan/channel": "workspace:*",
    "@wenyan/core": "workspace:*",
    "@wenyan/genesis": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "typescript": "^5.9.3"
  }
}
