{
  "name": "@wenyan/shared",
  "version": "0.1.0",
  "description": "Shared facade and compatibility types for Wenyan",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./themes/default.json": "./themes/default.json",
    "./themes/barry.json": "./themes/barry.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests configured yet'",
    "lint": "echo 'no lint configured yet'"
  },
  "dependencies": {
    "@wenyan/actor": "workspace:*",
    "@wenyan/core": "workspace:*",
    "@wenyan/seal": "workspace:*",
    "json5": "^2.2.3",
    "jsonrepair": "^3.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
