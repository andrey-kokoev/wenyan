# Environment Configuration
ENVIRONMENT=development

# Microsoft OAuth Configuration
AUTH_MICROSOFT_CLIENT_ID=your-client-id
AUTH_MICROSOFT_CLIENT_SECRET=your-client-secret
AUTH_MICROSOFT_TENANT=common
AUTH_MICROSOFT_REDIRECT_URL=http://localhost:8787/auth/callback

# Session Encryption (generate with: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret

# Service-to-Service Auth Token (generate with: openssl rand -base64 32)
SERVICE_TOKEN=your-service-token

# Database Configuration (Cloudflare D1)
# DB will be bound via wrangler.toml

# Log Level
LOG_LEVEL=info
