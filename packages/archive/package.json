{
  "name": "@wenyan/archive",
  "version": "0.2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./sqlite": {
      "types": "./src/sqlite.ts",
      "import": "./src/sqlite.ts"
    },
    "./cloudflare": {
      "types": "./src/cloudflare.ts",
      "import": "./src/cloudflare.ts"
    },
    "./adapter": {
      "types": "./src/adapter.ts",
      "import": "./src/adapter.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src --passWithNoTests",
    "lint": "echo 'no lint configured yet'"
  },
  "dependencies": {
    "@wenyan/core": "workspace:*",
    "@wenyan/seal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
