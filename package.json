{
  "name": "wenyan",
  "private": true,
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-kokoev/wenyan.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "postinstall": "pnpm -r --filter '!@wenyan/tests' build",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @wenyan/server dev:local",
    "dev:local": "pnpm --filter @wenyan/server dev:local",
    "dev:remote": "pnpm --filter @wenyan/server dev",
    "dev:server:local": "pnpm --filter @wenyan/server dev:local",
    "dev:server:remote": "pnpm --filter @wenyan/server dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "release:pack:check": "tsx scripts/release-pack-check.ts",
    "genesis:verify": "tsx scripts/genesis-verify.ts",
    "test:archive:persistence": "tsx scripts/test-archive-persistence.ts",
    "test:seal:crypto": "tsx scripts/test-seal-crypto.ts",
    "test:initiality": "tsx scripts/test-initiality.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
